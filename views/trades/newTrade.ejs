<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="card-container">

  <div class="card-info">
    <h2>Start New Trade</h2>

    <form action="/trades/add" method="POST" class="edit-form">

      <div class="form-row">
        <label for="cardName"><strong>Card Name:</strong></label>
        <input type="text" id="cardName" name="cardName" required>
      </div>

      <div class="form-row">
        <label for="owner"><strong>Owner:</strong></label>
        <input type="text" id="owner" name="owner" required>
      </div>

      <div class="form-row">
        <label for="cardGrade"><strong>PSA Grade:</strong></label>
        <input type="text" id="cardGrade" name="cardGrade" required>
      </div>

      <div class="form-row">
        <label for="price"><strong>Price:</strong></label>
        <input type="text" id="price" name="price" placeholder="$0.00" required>
      </div>

      <div class="form-row">
        <label for="status"><strong>Status:</strong></label>
        <select id="status" name="status">
          <option value="open">Open</option>
          <option value="pending">Pending</option>
          <option value="sold">Sold</option>
        </select>
      </div>

      <div class="form-row">
        <label for="Set"><strong>Set:</strong></label>
        <select id="Set" name="Set">
          <option value="megaEvolution">Mega Evolution</option>
          <option value="scarletViolet">Scarlet & Violet</option>
        </select>
      </div>

      <div class="form-row">
        <label for="subSet"><strong>Sub Set:</strong></label>
        <select id="subSet" name="subSet">
          <option value="megaEvolutions">Mega Evolutions</option>
          <option value="phantasmalFlames">Phantasmal Flames</option>
          <option value="blackBolt">Black Bolt</option>
          <option value="whiteFlare">White Flare</option>
        </select>
      </div>

      <div class="form-row">
        <label for="image"><strong>Image Filename:</strong></label>
        <input type="text" id="image" name="image" placeholder="example.jpg" required>
      </div>

      <div class="form-actions">
        <button class="button" type="submit">Create Trade</button>
      </div>

    </form>

    <button class="back-button" onclick="window.history.back();">← Back</button>
  </div>

  <div>
    <p><em>Image preview will appear after saving.</em></p>
  </div>

</main>

<%- include('../partials/footer') %>