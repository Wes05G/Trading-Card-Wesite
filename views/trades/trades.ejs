<%- include('../partials/header') %>

<%- include('../partials/navbar') %>

<main>
    <div class="set-page">
        <h2>Pokemon</h2>
        <% if (Object.keys(grouped).length === 0) { %>
            <p>No cards are currently listed.</p>
        <% } %>
        <% Object.entries(grouped).forEach(([set, subSets]) => { %>
            <h3 class="set-heading"><%= set %></h3>
            <% Object.entries(subSets).forEach(([subSet, trades]) => { %>
                <h4 class="subset-heading"><%= subSet %></h4>
                <div class="card-grid">
                    <% trades.forEach(t => { %>
                        <a href="/trades/<%= t.id %>" class="card-thumb">
                            <img src="/Images/<%= t.image %>" alt="<%= t.cardName %>" width="110" height="150">
                            <p class="card-thumb-name"><%= t.cardName %></p>
                            <% if (t.status === 'pending') { %>
                                <span class="status-badge pending">Pending</span>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            <% }) %>
        <% }) %>
    </div>
</main>

<%- include('../partials/footer') %>

