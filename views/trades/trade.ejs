<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main>
  <div class="trade-detail-wrapper">

    <div class="trade-detail-info">
      <h2><%= trade.cardName %></h2>
      <p><strong>Owner:</strong> <%= trade.owner %></p>
      <p><strong>PSA Grade:</strong> <%= trade.cardGrade %></p>
      <p><strong>Price:</strong> <%= trade.price %></p>
      <p><strong>Status:</strong> <%= trade.status %></p>
      <p><strong>Set:</strong> <%= trade.Set %></p>
      <p><strong>Sub Set:</strong> <%= trade.subSet %></p>

      <div class="form-actions">
        <button class="button" onclick="window.history.back();">← Back</button>
        <% if (locals.currentUser && currentUser.id !== trade.userId) { %>
          <a class="button" href="/trades/<%= trade.id %>/offers">Trade</a>
        <% } %>
        
        <% if (locals.currentUser && currentUser.id !== trade.userId) { %>
        <% if (isWishlisted) { %>
          <form action="/trades/wishlist/remove/<%= trade.id %>" method="POST" style="display:inline;">
            <button class="button" type="submit">Remove from Wishlist</button>
              </form>
      <% } else { %>
        <form action="/trades/wishlist/add/<%= trade.id %>" method="POST" style="display:inline;">
          <button class="button" type="submit">Add to Wishlist</button>
          </form>
  <% } %>
<% } %>
        <% if (locals.currentUser && currentUser.id === trade.userId) { %>
          <a class="button" href="/trades/<%= trade.id %>/edit">Edit</a>
          <form action="/trades/delete/<%= trade.id %>" method="POST" style="display:inline;">
            <button class="button" type="submit" onclick="return confirm('Delete this card?');">Delete</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="trade-detail-image">
      <% if (trade && trade.image) { %>
        <img src="/Images/<%= trade.image %>" alt="<%= trade.cardName %>" width="260">
      <% } else { %>
        <p><em>No image on file for this card.</em></p>
      <% } %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>