<% include ../partials/header %>

<% include ../partials/navbar %>

<div class="wishlist-container">
  <h1>Wish List</h1>

  <form id="wish-form" action="/trades/wishlist" method="POST" class="wish-form">
    <input type="text" name="item" placeholder="Add a wish list item" required />
    <button type="submit">Add Item</button>
  </form>

  <div class="wish-list">
    <% if (wishItems && wishItems.length) { %>
      <ul>
        <% wishItems.forEach(function(item) { %>
          <li><span><%= item %></span></li>
          <button class="button" type="submit" onclick="return confirm('Delete this from wish list?');">Delete</button>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-message">No items yet. Add one above.</p>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>