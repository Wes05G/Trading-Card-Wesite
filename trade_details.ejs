<html>
<head>
    <link rel="stylesheet" href="Style.css">
    <title>MintPick - Card Details</title>
</head>
<body>
    <header class="site-header">
        <div class="header-left">
            <a href="index.html"><img src="Images/MintPick Logo .png" alt="MintPick Logo" width="100" height="100"></a>
            <h1>MintPick - The Trading Card Marketplace!</h1>
        </div>
        <div class="header-right">
            <button class="button login-button" onclick="location.href='login.html'">Login</button>
        </div>
    </header>
    <nav class="navbar">
            <ul>
                <li><a href="trades.html">Trades</a></li>
                <li><a href="newTrade.html"> Start Trade!</a></li>
                <li><a href="">Pending Trades</a></li>
                <li class="push-right"><a href="">Login</a></li>
            </ul>
