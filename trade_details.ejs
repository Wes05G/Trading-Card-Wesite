    <main class="card-container">
        <h2>Card Details</h2>
        <img id="cardImage" src="" alt="Card Image" width="200" height="250">
        <div class="card-info">
            <p id="cardName"></p>
            <p id="cardDescription"></p>
            <p id="cardGrade"></p>
            <p id="cardPrice"></p>
            <p id="status"></p>
        </div>
        <button class="back-button" onclick="window.history.back();">← Back</button>
    <script src="trade_details.js"></script>
    
</main>

    <footer>
        <ul class="footer-links">
            <li><a href="">About</a></li>
            <li><a href="">Contact</a></li>
        </ul>
        <div class="footer-right">
            <a href=""><img src="Images/Instagram.jpg" alt="Instagram Logo" width="30" height="30"></a>
            <a href=""><img src="Images/X.jpg" alt="X Logo" width="30" height="30"></a>
            <a href=""><img src="Images/Facebook.png" alt="Facebook Logo" width="30" height="30"></a>
        </div>

    </footer>
<script src="trade_details.js"></script>
